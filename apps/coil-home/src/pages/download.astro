---
import Layout from "../layouts/Layout.astro";
import { INSTALL_PLATFORMS, UNSIGNED_NOTE, fillCommand, renderEmphasis } from "../lib/install";
import { RELEASES_URL } from "../lib/releases";
---

<Layout
  title="Download — Coil"
  description="Download Coil for macOS (Apple Silicon) or Windows (x64). Built from the fork's release pipeline."
>
  <div class="download-page">
  <h1 class="heading">Download Coil</h1>
  <p class="subheading">
    <span id="version-label">Loading the latest build&hellip;</span>
    <a id="changelog-link" class="changelog-link" href={RELEASES_URL} target="_blank" rel="noopener noreferrer" style="display:none">All releases<span aria-hidden="true"> &#8599;</span></a>
  </p>

  <div class="platforms" id="platforms">
    <!-- macOS -->
    <section class="platform-section">
      <div class="platform-header">
        <svg class="platform-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 814 1000" aria-hidden="true"><path fill="currentColor" d="M788.1 340.9c-5.8 4.5-108.2 62.2-108.2 190.5 0 148.4 130.3 200.9 134.2 202.2-.6 3.2-20.7 71.9-68.7 141.9-42.8 61.6-87.5 123.1-155.5 123.1s-85.5-39.5-164-39.5c-76.5 0-103.7 40.8-165.9 40.8s-105.6-57-155.5-127C46.7 790.7 0 663 0 541.8c0-194.4 126.4-297.5 250.8-297.5 66.1 0 121.2 43.4 162.7 43.4 39.5 0 101.1-46 176.3-46 28.5 0 130.9 2.6 198.3 99.2zm-234-181.5c31.1-36.9 53.1-88.1 53.1-139.3 0-7.1-.6-14.3-1.9-20.1-50.6 1.9-110.8 33.7-147.1 75.8-28.5 32.4-55.1 83.6-55.1 135.5 0 7.8 1.3 15.6 1.9 18.1 3.2.6 8.4 1.3 13.6 1.3 45.4 0 102.5-30.4 135.5-71.3z"/></svg>
        <h2 class="platform-name">macOS</h2>
      </div>
      <div class="download-cards download-cards--single">
        <a class="download-card" id="card-mac" href={RELEASES_URL}>
          <span class="card-arch">Apple Silicon (arm64)</span>
          <span class="card-format" id="size-mac">.dmg</span>
        </a>
      </div>
    </section>

    <!-- Windows -->
    <section class="platform-section">
      <div class="platform-header">
        <svg class="platform-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 88 88" aria-hidden="true"><path fill="currentColor" d="m0 12.402 35.687-4.86.016 34.423-35.67.203zm35.67 33.529.028 34.453L.028 75.48.026 45.7zm4.326-39.025L87.314 0v41.527l-47.318.376zm47.329 39.349-.011 41.34-47.318-6.678-.066-34.739z"/></svg>
        <h2 class="platform-name">Windows</h2>
      </div>
      <div class="download-cards download-cards--single">
        <a class="download-card" id="card-win" href={RELEASES_URL}>
          <span class="card-arch">Windows 10, 11 (x64)</span>
          <span class="card-format" id="size-win">.exe</span>
        </a>
      </div>
    </section>
  </div>

  <p class="unsigned-note">{UNSIGNED_NOTE}</p>

  <!--
    Rendered inline, from the same scripts/coil/install-instructions.json the release workflow
    renders into every release body. This used to be one sentence pointing at "the release
    notes" without linking them, which meant a first-time reader could download a build and meet
    a Gatekeeper dialog calling it damaged with nothing on this page to explain it (issue #72).
  -->
  <section class="install">
    <h2 class="install-title">First launch needs one step</h2>
    <p class="install-lede">
      The in-app updater handles all of this for you afterwards — this is the first install only.
    </p>

    {INSTALL_PLATFORMS.map((platform) => (
      <article class="install-platform" data-platform={platform.assetPlatform}>
        <h3 class="install-platform-name">{platform.name}</h3>
        <p class="install-support">{platform.support}</p>
        <ol class="install-steps">
          {platform.steps.map((step) => (
            <li class="install-step">
              <p class="install-step-title">{step.title}</p>
              <p class="install-step-body" set:html={renderEmphasis(step.body)} />
              {step.command && (
                <div class="command">
                  <code
                    class="command-text"
                    data-command-template={fillCommand(step.command, "{file}")}
                  >{fillCommand(step.command, platform.exampleFile)}</code>
                  <button class="command-copy" type="button" aria-label={`Copy the ${platform.name} command`}>
                    Copy
                  </button>
                </div>
              )}
            </li>
          ))}
        </ol>
        {platform.afterword && <p class="install-afterword">{platform.afterword}</p>}
      </article>
    ))}
  </section>

  <section class="changes" id="changes" hidden>
    <h2 class="changes-title">What's new</h2>
    <ul class="changes-list" id="changes-list"></ul>
  </section>

  <p class="linux-note">
    Linux builds aren't published yet — build from{" "}
    <a href="https://github.com/radroid/t3code" target="_blank" rel="noopener noreferrer">source</a>.
  </p>

  <p class="releases-link">
    Looking for older versions? Check the{" "}
    <a href={RELEASES_URL} target="_blank" rel="noopener noreferrer">
      GitHub releases page<span aria-hidden="true"> &#8599;</span>
    </a>
  </p>
  </div>
</Layout>

<script>
  import { fetchLatestManifest, findAsset, formatSize, RELEASES_URL } from "../lib/releases";

  function wire(card: HTMLAnchorElement | null, size: HTMLElement | null, url: string, bytes: number) {
    if (card) card.href = url;
    if (size) size.textContent = formatSize(bytes);
  }

  async function init() {
    const versionLabel = document.getElementById("version-label");
    const changelogLink = document.getElementById("changelog-link") as HTMLAnchorElement | null;
    const mac = document.getElementById("card-mac") as HTMLAnchorElement | null;
    const win = document.getElementById("card-win") as HTMLAnchorElement | null;

    try {
      const manifest = await fetchLatestManifest();
      if (!manifest?.assets) throw new Error("manifest has no assets");

      if (versionLabel) {
        const built = new Date(manifest.builtAt).toLocaleDateString(undefined, {
          year: "numeric",
          month: "short",
          day: "numeric",
        });
        versionLabel.textContent = `${manifest.version} · built ${built}`;
      }

      if (changelogLink) changelogLink.style.display = "";

      const macAsset = findAsset(manifest, "darwin-arm64");
      if (macAsset) {
        wire(mac, document.getElementById("size-mac"), macAsset.url, macAsset.bytes);
      }

      const winAsset = findAsset(manifest, "win32-x64");
      if (winAsset) {
        wire(win, document.getElementById("size-win"), winAsset.url, winAsset.bytes);
      }

      // The commands rendered above name an example file. Now that the manifest has said which
      // file this reader is actually downloading, use that name — a command that is right for
      // some other build is the kind of wrong that reads as the reader's mistake.
      for (const asset of manifest.assets) {
        for (const el of document.querySelectorAll<HTMLElement>(
          `[data-platform="${asset.platform}"] [data-command-template]`,
        )) {
          const template = el.dataset.commandTemplate;
          if (template) el.textContent = template.replace("{file}", asset.file);
        }
      }

      const changes = (manifest.changes ?? []).slice(0, 10);
      const list = document.getElementById("changes-list");
      const section = document.getElementById("changes");
      if (changes.length && list && section) {
        for (const change of changes) {
          const li = document.createElement("li");
          li.textContent = change;
          list.append(li);
        }
        section.hidden = false;
      }
    } catch {
      // The relay can fail transiently. Degrade to the releases page rather than to a dead button.
      if (versionLabel) {
        versionLabel.textContent = "Couldn't reach the release relay.";
      }
      if (changelogLink) changelogLink.style.display = "";
      for (const card of [mac, win]) {
        if (card) card.href = RELEASES_URL;
      }
    }
  }

  // Copy buttons. Wired independently of the manifest fetch: the commands are on the page from
  // the first paint, so they have to be copyable even when the relay is unreachable.
  function wireCopyButtons() {
    for (const button of document.querySelectorAll<HTMLButtonElement>(".command-copy")) {
      button.addEventListener("click", async () => {
        const text = button.parentElement?.querySelector(".command-text")?.textContent;
        if (!text) return;
        try {
          await navigator.clipboard.writeText(text);
          button.textContent = "Copied";
        } catch {
          // Clipboard access can be refused (insecure context, permissions policy). Select the
          // text instead so the reader can still copy it by hand rather than being told nothing.
          const node = button.parentElement?.querySelector(".command-text");
          if (node) {
            const range = document.createRange();
            range.selectNodeContents(node);
            const selection = window.getSelection();
            selection?.removeAllRanges();
            selection?.addRange(range);
          }
          button.textContent = "Select all";
        }
        setTimeout(() => {
          button.textContent = "Copy";
        }, 2000);
      });
    }
  }

  wireCopyButtons();
  init();
</script>

<style>
  .download-page {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 8vh 1.5rem 4rem;
  }

  /* ── Heading ── */

  .heading {
    font-weight: 500;
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    letter-spacing: -0.035em;
    line-height: 1.15;
    text-align: center;
    margin-bottom: 0.5rem;
    opacity: 0;
    animation: fade-in 1s ease-out forwards;
  }

  .subheading {
    font-size: 0.9rem;
    color: var(--fg-dim);
    margin-bottom: 3.5rem;
    opacity: 0;
    animation: fade-in 1s ease-out 0.1s forwards;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .changelog-link {
    color: var(--fg-muted);
    font-size: 0.8rem;
    text-decoration: underline;
    text-decoration-color: rgba(161, 161, 170, 0.4);
    text-underline-offset: 3px;
    transition: color 0.3s ease, text-decoration-color 0.3s ease;
  }

  .changelog-link:hover {
    color: var(--fg);
    text-decoration-color: var(--fg);
  }

  /* ── Platforms ── */

  .platforms {
    width: 100%;
    max-width: 720px;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    opacity: 0;
    animation: fade-in 1s ease-out 0.2s forwards;
  }

  .platform-section {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .platform-header {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
  }

  .platform-icon {
    width: 1.15em;
    height: 1.15em;
    color: var(--fg-muted);
    flex-shrink: 0;
  }

  .platform-name {
    font-weight: 500;
    font-size: 1.1rem;
    letter-spacing: -0.01em;
  }

  /* ── Download cards ── */

  .download-cards {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.5rem;
  }

  .download-card {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.85rem 1rem;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: rgba(255, 255, 255, 0.02);
    transition: background 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }

  .download-card:hover {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.15);
    transform: translateY(-1px);
  }

  .download-card:active {
    transform: translateY(0);
  }

  .card-arch {
    font-weight: 600;
    font-size: 0.95rem;
  }

  .card-format {
    font-size: 0.8rem;
    color: var(--fg-dim);
  }

  .download-cards--single {
    grid-template-columns: 1fr;
  }

  /* ── Notes ── */

  .unsigned-note,
  .linux-note {
    width: 100%;
    max-width: 720px;
    margin-top: 1.5rem;
    font-size: 0.825rem;
    line-height: 1.5;
    color: var(--fg-dim);
    opacity: 0;
    animation: fade-in 1s ease-out 0.3s forwards;
  }

  .linux-note a {
    color: var(--fg-muted);
    text-decoration: underline;
    text-decoration-color: rgba(161, 161, 170, 0.4);
    text-underline-offset: 3px;
    transition: color 0.3s ease;
  }

  .linux-note a:hover {
    color: var(--fg);
  }

  /* ── First launch ── */

  .install {
    width: 100%;
    max-width: 720px;
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    opacity: 0;
    animation: fade-in 1s ease-out 0.3s forwards;
  }

  .install-title {
    font-weight: 500;
    font-size: 1rem;
    letter-spacing: -0.01em;
  }

  .install-lede {
    margin-top: 0.4rem;
    font-size: 0.825rem;
    line-height: 1.5;
    color: var(--fg-dim);
  }

  .install-platform {
    margin-top: 1.75rem;
  }

  .install-platform-name {
    font-weight: 500;
    font-size: 0.9rem;
  }

  .install-support {
    margin-top: 0.2rem;
    font-size: 0.8rem;
    color: var(--fg-dim);
  }

  .install-steps {
    margin: 0.9rem 0 0;
    padding-left: 1.15rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    font-size: 0.85rem;
    line-height: 1.55;
  }

  .install-step::marker {
    color: var(--fg-faint);
  }

  .install-step-title {
    color: var(--fg);
  }

  .install-step-body {
    margin-top: 0.15rem;
    color: var(--fg-muted);
  }

  .install-step-body :global(strong) {
    color: var(--fg);
    font-weight: 500;
  }

  .install-afterword {
    margin-top: 1rem;
    font-size: 0.8rem;
    line-height: 1.5;
    color: var(--fg-dim);
  }

  .command {
    display: flex;
    align-items: stretch;
    gap: 0.5rem;
    margin-top: 0.6rem;
  }

  .command-text {
    flex: 1;
    min-width: 0;
    padding: 0.55rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--bg-card);
    color: var(--fg);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.78rem;
    line-height: 1.4;
    /* The macOS command is long and the Windows filename changes per build; wrapping keeps
       the whole command visible rather than hiding its tail behind a scrollbar nobody drags. */
    overflow-wrap: anywhere;
    white-space: pre-wrap;
  }

  .command-copy {
    flex: none;
    padding: 0 0.75rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: transparent;
    color: var(--fg-muted);
    font-size: 0.78rem;
    cursor: pointer;
    transition:
      color 0.2s ease,
      border-color 0.2s ease;
  }

  .command-copy:hover {
    color: var(--fg);
    border-color: var(--border-strong);
  }

  /* ── What's new ── */

  .changes {
    width: 100%;
    max-width: 720px;
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    opacity: 0;
    animation: fade-in 1s ease-out 0.3s forwards;
  }

  .changes-title {
    font-weight: 500;
    font-size: 1rem;
    letter-spacing: -0.01em;
    margin-bottom: 0.85rem;
  }

  .changes-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  /*
   * `:global` is load-bearing: these <li>s are created by the script at runtime, so they never
   * receive Astro's scoping attribute and a plain `.changes-list li` rule would not match them.
   */
  .changes-list :global(li) {
    position: relative;
    padding-left: 1.15rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--fg-muted);
  }

  .changes-list :global(li)::before {
    content: "+";
    position: absolute;
    left: 0;
    color: var(--accent);
  }

  /* ── Releases link ── */

  .releases-link {
    margin-top: 3rem;
    font-size: 0.825rem;
    color: var(--fg-dim);
    opacity: 0;
    animation: fade-in 1s ease-out 0.35s forwards;
  }

  .releases-link a {
    color: var(--fg-muted);
    text-decoration: underline;
    text-decoration-color: rgba(161, 161, 170, 0.4);
    text-underline-offset: 3px;
    transition: color 0.3s ease, text-decoration-color 0.3s ease;
  }

  .releases-link a:hover {
    color: var(--fg);
    text-decoration-color: var(--fg);
  }

  /* ── Mobile ── */

  @media (max-width: 640px) {
    .download-page {
      padding: 5vh 1.25rem 4rem;
    }

    .platforms {
      padding: 0 0.25rem;
    }

    .download-cards {
      grid-template-columns: 1fr;
    }
  }
</style>
