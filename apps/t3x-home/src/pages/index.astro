      </p>
    </div>
  </section>
</Layout>

<script>
  import { fetchLatestManifest, findAsset } from "../lib/releases";

  function point(id: string, url: string) {
    const el = document.getElementById(id) as HTMLAnchorElement | null;
    if (el) el.href = url;
  }

  async function init() {
    const kbd = document.getElementById("pr-button-kbd");
    if (kbd && !/Mac/i.test(navigator.userAgent)) kbd.textContent = "Ctrl ⏎";

    try {
      const manifest = await fetchLatestManifest();
      if (!manifest?.assets) return;

      const mac = findAsset(manifest, "darwin-arm64");
      if (mac) {
        point("download-mac", mac.url);
        point("cta-download-mac", mac.url);
      }

      const win = findAsset(manifest, "win32-x64");
      if (win) {
        point("download-win", win.url);
        point("cta-download-win", win.url);
      }

      // The sync strip is the page's one live claim: the version we ship, the upstream version
      // it tracks, and when it was built. Anything less specific would just be a slogan.
      const strip = document.querySelector("[data-sync-strip]");
      if (strip) {
        const upstream = manifest.version.split("-t3x")[0];
        const built = new Date(manifest.builtAt).toLocaleDateString(undefined, {
          month: "short",
          day: "numeric",
        });
        strip.textContent = `${manifest.version} · tracking upstream v${upstream} · built ${built}`;
      }
    } catch {
      // Nothing to do: the buttons already point at the releases page from the server-rendered
      // markup, and the strip keeps its static "Rebased onto upstream daily" text.
    }
  }

  init();
</script>

