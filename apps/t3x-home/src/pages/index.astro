---
import Layout from "../layouts/Layout.astro";
import { GITHUB_REPOSITORY_URL, UPSTREAM_REPOSITORY_URL } from "../lib/site";
---

<Layout>
  <!-- ── Hero ──────────────────────────────────────────────────── -->
  <section class="hero">
    <div class="hero-grid" aria-hidden="true"></div>

    <div class="hero-float" aria-hidden="true">
      <span class="hero-float-mark hf-claude" title="Claude Code">
        <img src="/harnesses/claude-ai-icon.svg" alt="" />
      </span>
      <span class="hero-float-mark hf-codex" title="Codex">
        <img src="/harnesses/openai_dark.svg" alt="" />
      </span>
      <span class="hero-float-mark hf-opencode" title="OpenCode">
        <img src="/harnesses/opencode-dark.svg" alt="" />
      </span>
      <span class="hero-float-mark hf-cursor" title="Cursor">
        <img src="/harnesses/cursor_light.svg" alt="" />
      </span>
      <span class="hero-float-mark hf-grok" title="Grok">
        <img src="/harnesses/grok-dark.svg" alt="" />
      </span>
    </div>

    <div class="container hero-inner">
      <h1 class="hero-title display">
        T3X.<br />T3 Code, one<br />branch ahead.
      </h1>

      <p class="hero-sub">
        A community fork of <a href={UPSTREAM_REPOSITORY_URL} target="_blank" rel="noopener noreferrer">T3 Code</a>
        {" "}(MIT) — the open-source control plane for coding agents. Same product, rebased onto
        upstream every day, plus the things we wanted sooner.
      </p>

      <div class="hero-actions">
        <div class="hero-dl-row">
          <a id="download-mac" class="btn btn-primary btn-lg" href="https://github.com/radroid/t3code/releases">
            <svg class="dl-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 814 1000" aria-hidden="true"><path fill="currentColor" d="M788.1 340.9c-5.8 4.5-108.2 62.2-108.2 190.5 0 148.4 130.3 200.9 134.2 202.2-.6 3.2-20.7 71.9-68.7 141.9-42.8 61.6-87.5 123.1-155.5 123.1s-85.5-39.5-164-39.5c-76.5 0-103.7 40.8-165.9 40.8s-105.6-57-155.5-127C46.7 790.7 0 663 0 541.8c0-194.4 126.4-297.5 250.8-297.5 66.1 0 121.2 43.4 162.7 43.4 39.5 0 101.1-46 176.3-46 28.5 0 130.9 2.6 198.3 99.2zm-234-181.5c31.1-36.9 53.1-88.1 53.1-139.3 0-7.1-.6-14.3-1.9-20.1-50.6 1.9-110.8 33.7-147.1 75.8-28.5 32.4-55.1 83.6-55.1 135.5 0 7.8 1.3 15.6 1.9 18.1 3.2.6 8.4 1.3 13.6 1.3 45.4 0 102.5-30.4 135.5-71.3z"/></svg>
            <span>Download for macOS</span>
          </a>
          <a id="download-win" class="btn btn-ghost btn-lg" href="https://github.com/radroid/t3code/releases">
            <svg class="dl-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 88 88" aria-hidden="true"><path fill="currentColor" d="m0 12.402 35.687-4.86.016 34.423-35.67.203zm35.67 33.529.028 34.453L.028 75.48.026 45.7zm4.326-39.025L87.314 0v41.527l-47.318.376zm47.329 39.349-.011 41.34-47.318-6.678-.066-34.739z"/></svg>
            <span>Windows</span>
          </a>
        </div>

        <p class="hero-honesty">
          Unsigned builds for macOS (Apple Silicon) and Windows (x64). No store apps.
        </p>

        <p class="hero-sync" data-sync-strip>Rebased onto upstream daily</p>

        <a class="hero-source-link" href={GITHUB_REPOSITORY_URL} target="_blank" rel="noopener noreferrer">
          <svg class="hero-source-mark" width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 .5C5.65.5.5 5.65.5 12a11.5 11.5 0 007.86 10.93c.58.1.79-.25.79-.56v-2c-3.2.69-3.88-1.37-3.88-1.37-.52-1.33-1.27-1.69-1.27-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.76 2.68 1.25 3.33.96.1-.75.4-1.25.72-1.54-2.55-.29-5.24-1.27-5.24-5.67 0-1.25.45-2.28 1.18-3.08-.12-.29-.51-1.45.11-3.02 0 0 .96-.31 3.15 1.18a10.96 10.96 0 015.74 0c2.19-1.49 3.15-1.18 3.15-1.18.62 1.57.23 2.73.11 3.02.74.8 1.18 1.83 1.18 3.08 0 4.41-2.7 5.38-5.27 5.66.41.36.78 1.06.78 2.13v3.16c0 .31.21.67.8.56A11.5 11.5 0 0023.5 12C23.5 5.65 18.35.5 12 .5z"/>
          </svg>
          <span>Read the fork on GitHub</span>
          <svg class="hero-source-arrow" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M8 7h9v9"/></svg>
        </a>
      </div>

      <div class="hero-preview">
        <figure class="hero-screenshot-frame">
          <img
            src="/updated-screenshot.webp"
            alt="T3X showing multiple coding agent threads side by side in one workspace"
            width="2508"
            height="1682"
            loading="eager"
            decoding="async"
          />
        </figure>
      </div>
    </div>
  </section>

  <!-- ── Fork graph ────────────────────────────────────────────── -->
  <!--
    Structure carries the argument: one `main` rail holding what the core product already does,
    and a `t3x` rail branching off it holding what this fork adds. Which feature comes from where
    is legible from the shape, not from a label. Rails and dots are pure CSS — no images, no JS.
  -->
  <section id="fork-graph" class="sec-fork-graph" aria-labelledby="fork-graph-title">
    <div class="container">
      <div class="section-head">
        <div class="eyebrow">The fork</div>
        <h2 id="fork-graph-title">Everything T3 Code is. Plus a branch.</h2>
        <p>
          T3X ships upstream's product unchanged and adds to it. Nothing below is a
          reimplementation — the <code>main</code> rail is T3 Code's work, the
          <code>t3x</code> rail is ours.
        </p>
      </div>

      <div class="graph">
        <div class="graph-rail graph-rail--main">
          <div class="graph-rail-label">
            <span class="graph-rail-name">main</span>
            <span class="graph-rail-note">upstream · T3 Tools Inc</span>
          </div>
          <ol class="graph-commits">
            <li class="graph-commit">
              <h3>Every agent, one workspace</h3>
              <p>Threads from all your coding agents, side by side in one control plane.</p>
            </li>
            <li class="graph-commit">
              <h3>Bring your own sub</h3>
              <p>Plug in Claude Code, Codex, or OpenCode. T3 Code doesn't resell tokens.</p>
            </li>
            <li class="graph-commit">
              <h3>⌘⏎ Commit, push, PR</h3>
              <p>One button from finished diff to open pull request.</p>
            </li>
            <li class="graph-commit">
              <h3>MIT open source</h3>
              <p>Read it, patch it, fork it.</p>
            </li>
          </ol>
        </div>

        <div class="graph-fork" aria-hidden="true">
          <span class="graph-fork-caption">rebased onto upstream daily</span>
        </div>

        <div class="graph-rail graph-rail--branch">
          <div class="graph-rail-label">
            <span class="graph-rail-name">t3x</span>
            <span class="graph-rail-note">this fork</span>
          </div>
          <ol class="graph-commits">
            <li class="graph-commit">
              <h3>Auto-updates</h3>
              <p>New builds announce themselves with a changelog toast and install while you're idle.</p>
            </li>
            <li class="graph-commit">
              <h3>Needs-input notifications</h3>
              <p>When an agent stalls on a question, your desktop and your phone find out — not the tab you forgot.</p>
            </li>
            <li class="graph-commit">
              <h3>Web Push + tolerant reconnect</h3>
              <p>Notifications reach the browser on your phone, and a slow-but-alive local backend stops reading as "disconnected".</p>
            </li>
            <li class="graph-commit">
              <h3>Auto-resume</h3>
              <p>Interrupted runs pick themselves back up, with a countdown you can cancel.</p>
            </li>
            <li class="graph-commit">
              <h3>Daily upstream sync</h3>
              <p>An automated agent rebases this fork onto upstream every day and keeps a public ledger of every divergence.</p>
            </li>
            <li class="graph-commit">
              <h3>Dependency security sweep</h3>
              <p>Pinned overrides that took open Dependabot alerts from 107 to 6, and survive every sync.</p>
            </li>
          </ol>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Harnesses ─────────────────────────────────────────────── -->
  <section id="harnesses" class="sec-harness">
    <div class="container">
      <div class="section-head">
        <h2>Bring your own sub</h2>
        <p>
          T3 Code doesn't resell tokens. Plug in Claude Code, Codex, OpenCode,
          Cursor, or Grok with the credentials you already have — we orchestrate
          them, you keep your plan.
        </p>
      </div>

      <div class="harness-grid">
        <div class="harness">
          <div class="harness-mark"><img src="/harnesses/claude-ai-icon.svg" alt="" /></div>
          <div class="harness-meta">
            <div class="harness-name">Claude Code</div>
            <div class="harness-tag">claude auth login</div>
          </div>
        </div>
        <div class="harness">
          <div class="harness-mark"><img src="/harnesses/openai_dark.svg" alt="" /></div>
          <div class="harness-meta">
            <div class="harness-name">Codex CLI</div>
            <div class="harness-tag">codex login</div>
          </div>
        </div>
        <div class="harness">
          <div class="harness-mark"><img src="/harnesses/opencode-dark.svg" alt="" /></div>
          <div class="harness-meta">
            <div class="harness-name">OpenCode</div>
            <div class="harness-tag">opencode auth</div>
          </div>
        </div>
        <div class="harness">
          <div class="harness-mark"><img src="/harnesses/cursor_light.svg" alt="" /></div>
          <div class="harness-meta">
            <div class="harness-name">Cursor</div>
            <div class="harness-tag">cursor-agent</div>
          </div>
        </div>
        <div class="harness">
          <div class="harness-mark"><img src="/harnesses/grok-dark.svg" alt="" /></div>
          <div class="harness-meta">
            <div class="harness-name">Grok CLI</div>
            <div class="harness-tag">grok login</div>
          </div>
        </div>
      </div>

      <div class="harness-footer">
        <div class="harness-footer-item"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12l5 5L20 6"/></svg> No keys resold. No quota caps.</div>
        <div class="harness-footer-item"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12l5 5L20 6"/></svg> Switch models mid-thread.</div>
        <div class="harness-footer-item"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12l5 5L20 6"/></svg> More harnesses shipping weekly.</div>
      </div>
    </div>
  </section>

  <!-- ── Git ──────────────────────────────────────────────────── -->
  <section id="git" class="sec-git">
    <div class="container git-inner">
      <div class="git-visual">
        <div class="pr-card tile">
          <div class="pr-head">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="6" r="2.2"/><circle cx="6" cy="18" r="2.2"/><circle cx="18" cy="6" r="2.2"/><path d="M6 8v8M18 8v5a3 3 0 01-3 3h-3M13 13l-2 3 2 3"/></svg>
            <span class="pr-title">Add marketing hero animation</span>
            <span class="pr-status">Ready</span>
          </div>
          <div class="pr-meta">
            <span><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="6" r="2.2"/><circle cx="6" cy="18" r="2.2"/><circle cx="18" cy="6" r="2.2"/><path d="M6 8v8M6 12a6 6 0 006-6h6"/></svg> feat/marketing-hero → main</span>
            <span>+142 −38</span>
            <span>3 commits</span>
          </div>
          <div class="pr-files">
            <div><code>apps/marketing/src/pages/index.astro</code> <span>+14 −2</span></div>
            <div><code>apps/marketing/src/layouts/Layout.astro</code> <span>+8 −0</span></div>
            <div><code>apps/marketing/public/hero.css</code> <span>+120 −36</span></div>
          </div>
          <div class="pr-foot">
            <button class="btn btn-ghost" style="font-size:12px;padding:6px 10px">View diff</button>
            <button class="btn btn-primary" style="font-size:12px;padding:6px 12px">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.65.5.5 5.65.5 12a11.5 11.5 0 007.86 10.93c.58.1.79-.25.79-.56v-2c-3.2.69-3.88-1.37-3.88-1.37-.52-1.33-1.27-1.69-1.27-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.76 2.68 1.25 3.33.96.1-.75.4-1.25.72-1.54-2.55-.29-5.24-1.27-5.24-5.67 0-1.25.45-2.28 1.18-3.08-.12-.29-.51-1.45.11-3.02 0 0 .96-.31 3.15 1.18a10.96 10.96 0 015.74 0c2.19-1.49 3.15-1.18 3.15-1.18.62 1.57.23 2.73.11 3.02.74.8 1.18 1.83 1.18 3.08 0 4.41-2.7 5.38-5.27 5.66.41.36.78 1.06.78 2.13v3.16c0 .31.21.67.8.56A11.5 11.5 0 0023.5 12C23.5 5.65 18.35.5 12 .5z"/></svg>
              Open pull request
            </button>
          </div>
        </div>
        <div class="pr-trail">
          <div class="pr-trail-dot"></div>
          <div class="pr-trail-line"></div>
          <div class="pr-trail-dot"></div>
        </div>
        <div class="pr-button-shell">
          <button class="pr-button">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="6" r="2.2"/><circle cx="6" cy="18" r="2.2"/><circle cx="18" cy="6" r="2.2"/><path d="M6 8v8M18 8v5a3 3 0 01-3 3h-3M13 13l-2 3 2 3"/></svg>
            Commit &amp; push
            <span id="pr-button-kbd" class="pr-button-kbd">⌘⏎</span>
          </button>
        </div>
      </div>

      <div class="git-copy">
        <div class="section-head" style="margin-bottom:0">
          <h2>One button to commit, push, and make a PR.</h2>
          <p>
            Every agent thread writes to its own branch. When it's good, one
            button opens the PR on GitHub with a generated title, body and
            changelog. No terminal dance required.
          </p>
          <ul class="checklist" style="margin-top:24px">
            <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12l5 5L20 6"/></svg> Auto-generated PR titles &amp; bodies</li>
            <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12l5 5L20 6"/></svg> Inline diff review before you push</li>
            <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12l5 5L20 6"/></svg> Draft PRs, stack PRs, amend PRs</li>
            <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12l5 5L20 6"/></svg> Works with your existing GitHub auth</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Open source ───────────────────────────────────────────── -->
  <section id="open" class="sec-open">
    <div class="container">
      <div class="section-head open-head">
        <div class="eyebrow">Open source</div>
        <h2>If you don't like something, fork it.</h2>
        <p>
          So we did. T3X is that fork: same product, same license, plus the things we wanted
          sooner. Every line we change on top of upstream is{" "}
          <a
            href="https://github.com/radroid/t3code/blob/main/docs/t3x/SEAMS.md"
            target="_blank"
            rel="noopener noreferrer"
          >public</a> — additions only, re-checked against upstream every day.
        </p>
      </div>

      <div class="open-grid">
        <div class="tile open-term">
          <div class="open-term-head">
            <span></span><span></span><span></span>
            <span class="open-term-title">~/code</span>
          </div>
          <div class="open-term-body">
            <div><span class="prompt">$</span> gh repo fork radroid/t3code --clone</div>
            <div class="dim">✓ Cloned t3code into ./t3code</div>
            <div><span class="prompt">$</span> cd t3code &amp;&amp; vp install</div>
            <div class="dim">✓ 1 284 packages installed in 4.2s</div>
            <div><span class="prompt">$</span> vp run dev</div>
            <div class="dim">▲ T3X dev server → <span class="accent">http://localhost:4001</span></div>
            <div class="cursor"><span class="prompt">$</span><span class="caret"></span></div>
          </div>
        </div>

        <div class="tile open-pitch">
          <div class="open-pitch-copy">
            <ul class="open-pitch-list">
              <li>
                <span class="open-pitch-mark" aria-hidden="true"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span>
                <span><strong>Change the UI.</strong> Restyle every surface to match your taste.</span>
              </li>
              <li>
                <span class="open-pitch-mark" aria-hidden="true"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span>
                <span><strong>Add an agent.</strong> Wire in your own tools, models, and flows.</span>
              </li>
              <li>
                <span class="open-pitch-mark" aria-hidden="true"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span>
                <span><strong>Ship your own build.</strong> Self-host it or distribute it as your own.</span>
              </li>
            </ul>
          </div>

          <div class="open-pitch-footer">
            <div class="open-pitch-meta">
              <span>MIT licensed</span>
              <span aria-hidden="true">·</span>
              <a href={GITHUB_REPOSITORY_URL} target="_blank" rel="noopener noreferrer">Open source</a>
            </div>

            <div class="open-pitch-actions">
              <a class="btn btn-primary" href={`${GITHUB_REPOSITORY_URL}/fork`} target="_blank" rel="noopener noreferrer">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="6" cy="5" r="2.2"/><circle cx="18" cy="5" r="2.2"/><circle cx="12" cy="19" r="2.2"/><path d="M6 7.2v2A3 3 0 009 12.2h6A3 3 0 0018 9.2v-2M12 14v2.8"/></svg>
                Fork on GitHub
              </a>
              <a class="open-source-link" href={GITHUB_REPOSITORY_URL} target="_blank" rel="noopener noreferrer">
                Browse source
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M8 7h9v9"/></svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Final CTA ─────────────────────────────────────────────── -->
  <section id="download" class="sec-cta">
    <div class="container cta-inner">
      <h2 class="display cta-title">
        Your agents deserve better than a terminal.
      </h2>
      <p class="cta-sub">
        T3X is free, open source, and current with upstream. Install it, plug in the harness
        you already pay for, and let your agents get to work.
      </p>
      <div class="cta-actions">
        <a id="cta-download-mac" class="btn btn-primary btn-lg" href="https://github.com/radroid/t3code/releases">
          <svg class="dl-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 814 1000" aria-hidden="true"><path fill="currentColor" d="M788.1 340.9c-5.8 4.5-108.2 62.2-108.2 190.5 0 148.4 130.3 200.9 134.2 202.2-.6 3.2-20.7 71.9-68.7 141.9-42.8 61.6-87.5 123.1-155.5 123.1s-85.5-39.5-164-39.5c-76.5 0-103.7 40.8-165.9 40.8s-105.6-57-155.5-127C46.7 790.7 0 663 0 541.8c0-194.4 126.4-297.5 250.8-297.5 66.1 0 121.2 43.4 162.7 43.4 39.5 0 101.1-46 176.3-46 28.5 0 130.9 2.6 198.3 99.2zm-234-181.5c31.1-36.9 53.1-88.1 53.1-139.3 0-7.1-.6-14.3-1.9-20.1-50.6 1.9-110.8 33.7-147.1 75.8-28.5 32.4-55.1 83.6-55.1 135.5 0 7.8 1.3 15.6 1.9 18.1 3.2.6 8.4 1.3 13.6 1.3 45.4 0 102.5-30.4 135.5-71.3z"/></svg>
          <span>Download for macOS</span>
        </a>
        <a id="cta-download-win" class="btn btn-ghost btn-lg" href="https://github.com/radroid/t3code/releases">
          <svg class="dl-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 88 88" aria-hidden="true"><path fill="currentColor" d="m0 12.402 35.687-4.86.016 34.423-35.67.203zm35.67 33.529.028 34.453L.028 75.48.026 45.7zm4.326-39.025L87.314 0v41.527l-47.318.376zm47.329 39.349-.011 41.34-47.318-6.678-.066-34.739z"/></svg>
          <span>Windows</span>
        </a>
      </div>
      <p class="cta-note">
